{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-travel.example/contracts/risk-knowledge/1.0.0/schema.json",
  "title": "Smart Travel Risk and Knowledge Internal Contract",
  "description": "Canonical version 1 schemas owned by module 06 and consumed by the agent, integration, and decision services.",
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "RiskLevel": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"]
    },
    "DataStatus": {
      "type": "string",
      "enum": ["FRESH", "STALE", "UNAVAILABLE", "CONFLICTING", "PARTIAL"]
    },
    "Severity": {
      "type": "string",
      "enum": ["INFO", "MINOR", "MODERATE", "SEVERE", "EXTREME", "UNKNOWN"]
    },
    "SourceAuthority": {
      "type": "string",
      "enum": ["OFFICIAL", "INTERGOVERNMENTAL", "LICENSED_PROVIDER", "COMMUNITY", "UNKNOWN"]
    },
    "QualityFlag": {
      "type": "string",
      "enum": ["MISSING", "STALE", "CONFLICTING", "INFERRED", "INCOMPLETE", "OUTSIDE_COVERAGE"]
    },
    "ReasonCode": {
      "type": "string",
      "enum": [
        "OFFICIAL_CLOSURE",
        "OFFICIAL_EVACUATION",
        "EXTREME_WARNING_CORRIDOR",
        "SEVERE_WEATHER_CORRIDOR",
        "DISASTER_CORRIDOR_INTERSECTION",
        "TRANSPORT_DISRUPTION",
        "LIMITED_CRITICAL_COVERAGE",
        "STALE_CRITICAL_EVIDENCE",
        "CONFLICTING_OFFICIAL_EVIDENCE",
        "MODEL_UNAVAILABLE",
        "FEATURE_SCHEMA_MISMATCH",
        "NO_USABLE_ROUTE",
        "FALLBACK_RULE_APPLIED"
      ]
    },
    "LimitationCode": {
      "type": "string",
      "enum": [
        "NO_RELIABLE_KNOWLEDGE_EVIDENCE",
        "MODEL_UNAVAILABLE",
        "MODEL_ARTIFACT_INVALID",
        "FEATURE_SCHEMA_UNSUPPORTED",
        "KNOWLEDGE_COLLECTION_UNAVAILABLE",
        "ROUTE_RANKING_UNAVAILABLE",
        "INSUFFICIENT_EVIDENCE",
        "DEPENDENCY_UNAVAILABLE"
      ]
    },
    "DataQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "score", "flags", "coverage", "completeness", "freshness_seconds", "conflicts", "notes"],
      "properties": {
        "status": { "$ref": "#/$defs/DataStatus" },
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "flags": { "type": "array", "items": { "$ref": "#/$defs/QualityFlag" }, "uniqueItems": true },
        "coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "completeness": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "freshness_seconds": { "type": ["integer", "null"], "minimum": 0 },
        "conflicts": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 100 },
        "notes": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 100 }
      }
    },
    "SourceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "provider",
        "provider_record_id",
        "authority",
        "source_url",
        "license",
        "observed_at",
        "published_at",
        "fetched_at",
        "expires_at",
        "content_hash",
        "schema_version"
      ],
      "properties": {
        "source_id": { "$ref": "#/$defs/Uuid" },
        "provider": { "type": "string", "minLength": 1, "maxLength": 100 },
        "provider_record_id": { "type": ["string", "null"], "maxLength": 500 },
        "authority": { "$ref": "#/$defs/SourceAuthority" },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "license": { "type": "string", "minLength": 1, "maxLength": 500 },
        "observed_at": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "published_at": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "fetched_at": { "$ref": "#/$defs/Timestamp" },
        "expires_at": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "schema_version": { "type": "string", "const": "1.0.0" }
      }
    },
    "GeoJsonGeometry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Point" },
            "coordinates": {
              "type": "array",
              "prefixItems": [
                { "type": "number", "minimum": -180, "maximum": 180 },
                { "type": "number", "minimum": -90, "maximum": 90 }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "enum": ["LineString", "Polygon", "MultiPolygon", "MultiLineString"] },
            "coordinates": { "type": "array", "minItems": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "RouteExposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "hazard_event_ids", "weather_window_ids", "closed"],
      "properties": {
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "hazard_event_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "weather_window_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "closed": { "type": "boolean" },
        "hard_constraint_codes": {
          "type": "array",
          "items": { "enum": ["OFFICIAL_CLOSURE", "OFFICIAL_NO_GO", "EVACUATION_DIRECTION_CONFLICT"] },
          "uniqueItems": true
        }
      }
    },
    "RouteCandidate": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "route_id",
        "provider_route_id",
        "label",
        "mode",
        "geometry",
        "segments",
        "distance_m",
        "duration_seconds",
        "transfers",
        "exposure",
        "risk_level",
        "quality",
        "sources"
      ],
      "properties": {
        "route_id": { "$ref": "#/$defs/Uuid" },
        "provider_route_id": { "type": "string", "minLength": 1, "maxLength": 500 },
        "label": { "enum": ["ORIGINAL", "RECOMMENDED", "FASTEST", "LOWEST_RISK", "ALTERNATIVE"] },
        "mode": { "enum": ["FLIGHT", "TRAIN", "BUS", "CAR", "WALK", "BICYCLE", "MULTIMODAL"] },
        "geometry": { "$ref": "#/$defs/GeoJsonGeometry" },
        "segments": { "type": "array", "items": { "type": "object" } },
        "distance_m": { "type": "number", "minimum": 0 },
        "duration_seconds": { "type": "number", "minimum": 0 },
        "transfers": { "type": "integer", "minimum": 0 },
        "exposure": { "$ref": "#/$defs/RouteExposure" },
        "risk_level": { "$ref": "#/$defs/RiskLevel" },
        "quality": { "$ref": "#/$defs/DataQuality" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/SourceProvenance" } }
      }
    },
    "OfficialAlert": {
      "type": "object",
      "additionalProperties": true,
      "required": ["event_id", "severity", "official", "effective_at", "ends_at", "source"],
      "properties": {
        "event_id": { "type": "string", "minLength": 1, "maxLength": 500 },
        "event_type": { "type": "string", "minLength": 1, "maxLength": 100 },
        "severity": { "$ref": "#/$defs/Severity" },
        "official": { "const": true },
        "effective_at": { "$ref": "#/$defs/Timestamp" },
        "ends_at": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "affected_route_ids": { "type": "array", "items": { "$ref": "#/$defs/Uuid" }, "uniqueItems": true },
        "closure": { "type": "boolean", "default": false },
        "evacuation": { "type": "boolean", "default": false },
        "source": { "$ref": "#/$defs/SourceProvenance" }
      }
    },
    "IntegratedTravelContext": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "snapshot_id",
        "request_id",
        "trip_id",
        "schema_version",
        "feature_schema_version",
        "travel_window",
        "route_candidates",
        "route_corridor_geojson",
        "weather",
        "transport",
        "disaster_events",
        "official_alerts",
        "features",
        "quality_summary",
        "conflict_summary",
        "source_ids",
        "created_at",
        "content_hash"
      ],
      "properties": {
        "snapshot_id": { "$ref": "#/$defs/Uuid" },
        "request_id": { "$ref": "#/$defs/Uuid" },
        "trip_id": { "$ref": "#/$defs/Uuid" },
        "schema_version": { "type": "string", "const": "1.0.0" },
        "feature_schema_version": { "type": "string", "const": "1.0.0" },
        "travel_window": {
          "type": "object",
          "additionalProperties": false,
          "description": "Must stay compatible with jsonschema/common/integrated-travel-context.schema.json#/$defs/TravelWindow.",
          "required": ["starts_at", "ends_at", "timezone"],
          "properties": {
            "starts_at": { "$ref": "#/$defs/Timestamp" },
            "ends_at": { "$ref": "#/$defs/Timestamp" },
            "timezone": {
              "title": "Timezone",
              "description": "IANA time zone identifier, e.g. Asia/Bangkok. Validated against the tz database at the boundary, not by pattern alone.",
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9+_-]+(/[A-Za-z0-9+_.-]+)*$"
            }
          }
        },
        "route_candidates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/RouteCandidate" } },
        "route_corridor_geojson": { "$ref": "#/$defs/GeoJsonGeometry" },
        "weather": { "type": "array", "items": { "type": "object" } },
        "transport": { "type": "array", "items": { "type": "object" } },
        "disaster_events": { "type": "array", "items": { "type": "object" } },
        "official_alerts": { "type": "array", "items": { "$ref": "#/$defs/OfficialAlert" } },
        "features": {
          "type": "object",
          "description": "Feature names and null semantics are locked by services/risk-knowledge/governance/feature_schema.v1.yaml.",
          "additionalProperties": { "type": ["number", "integer", "boolean", "string", "null"] }
        },
        "quality_summary": { "$ref": "#/$defs/DataQuality" },
        "conflict_summary": { "type": "array", "items": { "type": "string", "maxLength": 500 } },
        "source_ids": { "type": "array", "items": { "$ref": "#/$defs/Uuid" }, "uniqueItems": true },
        "created_at": { "$ref": "#/$defs/Timestamp" },
        "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "supersedes_snapshot_id": { "anyOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }] }
      }
    },
    "ModelReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "feature_schema_version", "artifact_checksum"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "feature_schema_version": { "type": "string", "const": "1.0.0" },
        "artifact_checksum": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "SafetyOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "applied_risk_level", "source_ids", "policy_version"],
      "properties": {
        "code": { "enum": ["OFFICIAL_CLOSURE", "OFFICIAL_EVACUATION", "EXTREME_WARNING_CORRIDOR", "MISSING_CRITICAL_EVIDENCE", "OFFICIAL_SOURCE_CONFLICT"] },
        "applied_risk_level": { "$ref": "#/$defs/RiskLevel" },
        "source_ids": { "type": "array", "items": { "$ref": "#/$defs/Uuid" }, "uniqueItems": true },
        "policy_version": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "RiskAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_id",
        "snapshot_id",
        "route_id",
        "score",
        "probability_high",
        "risk_level",
        "uncertainty",
        "reason_codes",
        "safety_overrides",
        "model",
        "quality",
        "created_at"
      ],
      "properties": {
        "assessment_id": { "$ref": "#/$defs/Uuid" },
        "snapshot_id": { "$ref": "#/$defs/Uuid" },
        "route_id": { "$ref": "#/$defs/Uuid" },
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "probability_high": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "risk_level": { "$ref": "#/$defs/RiskLevel" },
        "uncertainty": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "reason_codes": { "type": "array", "items": { "$ref": "#/$defs/ReasonCode" }, "uniqueItems": true, "minItems": 1 },
        "safety_overrides": { "type": "array", "items": { "$ref": "#/$defs/SafetyOverride" } },
        "model": { "$ref": "#/$defs/ModelReference" },
        "quality": { "$ref": "#/$defs/DataQuality" },
        "created_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "RetrievedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "document_id",
        "authority",
        "title",
        "source_url",
        "page",
        "section",
        "language",
        "effective_at",
        "expires_at",
        "passage",
        "retrieval_score",
        "rerank_score",
        "collection_version",
        "content_hash"
      ],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/Uuid" },
        "document_id": { "type": "string", "minLength": 1, "maxLength": 300 },
        "authority": { "$ref": "#/$defs/SourceAuthority" },
        "title": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "page": { "type": ["integer", "null"], "minimum": 1 },
        "section": { "type": ["string", "null"], "maxLength": 1000 },
        "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
        "effective_at": { "$ref": "#/$defs/Timestamp" },
        "expires_at": { "$ref": "#/$defs/Timestamp" },
        "passage": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "retrieval_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "rerank_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "collection_version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "CapabilityState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "status", "version", "reason"],
      "properties": {
        "capability": { "enum": ["RISK_MODEL", "KNOWLEDGE_RETRIEVAL", "ROUTE_EVALUATION"] },
        "status": { "enum": ["AVAILABLE", "DEGRADED", "UNAVAILABLE", "WARMING"] },
        "version": { "type": ["string", "null"], "maxLength": 100 },
        "reason": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "StandardMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "correlation_id", "contract_version", "generated_at", "degraded_services"],
      "properties": {
        "request_id": { "$ref": "#/$defs/Uuid" },
        "correlation_id": { "$ref": "#/$defs/Uuid" },
        "contract_version": { "const": "1.0.0" },
        "generated_at": { "$ref": "#/$defs/Timestamp" },
        "degraded_services": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "FieldError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "code"],
      "properties": {
        "path": { "type": "string", "maxLength": 500 },
        "code": { "type": "string", "maxLength": 100 }
      }
    },
    "ErrorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "meta"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "field_errors", "retryable", "retry_after_seconds"],
          "properties": {
            "code": {
              "enum": [
                "VALIDATION_ERROR",
                "AUTHENTICATION_REQUIRED",
                "FORBIDDEN",
                "NOT_FOUND",
                "CONFLICT",
                "DEPENDENCY_TIMEOUT",
                "DEPENDENCY_UNAVAILABLE",
                "INSUFFICIENT_EVIDENCE",
                "UNSUPPORTED_COVERAGE",
                "POLICY_VALIDATION_FAILED",
                "INTERNAL_ERROR"
              ]
            },
            "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "field_errors": { "type": "array", "items": { "$ref": "#/$defs/FieldError" } },
            "retryable": { "type": "boolean" },
            "retry_after_seconds": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "meta": { "$ref": "#/$defs/StandardMeta" }
      }
    },
    "RiskAssessRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "route_ids"],
      "properties": {
        "snapshot": { "$ref": "#/$defs/IntegratedTravelContext" },
        "route_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Uuid" } }
      }
    },
    "KnowledgeRetrieveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hazards", "country_codes", "action_code", "locale", "at"],
      "properties": {
        "hazards": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
        "country_codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]{2}$" } },
        "admin1": { "type": ["string", "null"], "maxLength": 200 },
        "action_code": { "enum": ["NORMAL", "CHANGE_ROUTE", "DELAY", "AVOID"] },
        "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
        "at": { "$ref": "#/$defs/Timestamp" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5 }
      }
    },
    "RouteEvaluateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "route_ids", "avoid_geometries", "preferences"],
      "properties": {
        "snapshot": { "$ref": "#/$defs/IntegratedTravelContext" },
        "route_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Uuid" } },
        "avoid_geometries": { "type": "array", "items": { "$ref": "#/$defs/GeoJsonGeometry" } },
        "preferences": { "type": "object", "additionalProperties": true }
      }
    },
    "EvidencePackageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "locale"],
      "properties": {
        "snapshot_id": { "$ref": "#/$defs/Uuid" },
        "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
        "route_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Uuid" } }
      }
    },
    "RiskAssessResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assessments", "capability", "limitations"],
          "properties": {
            "assessments": { "type": "array", "items": { "$ref": "#/$defs/RiskAssessment" } },
            "capability": { "$ref": "#/$defs/CapabilityState" },
            "limitations": { "type": "array", "items": { "$ref": "#/$defs/LimitationCode" }, "uniqueItems": true }
          }
        },
        "meta": { "$ref": "#/$defs/StandardMeta" }
      }
    },
    "KnowledgeRetrieveResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence", "capability", "limitations"],
          "properties": {
            "evidence": { "type": "array", "items": { "$ref": "#/$defs/RetrievedEvidence" } },
            "capability": { "$ref": "#/$defs/CapabilityState" },
            "limitations": { "type": "array", "items": { "$ref": "#/$defs/LimitationCode" }, "uniqueItems": true }
          }
        },
        "meta": { "$ref": "#/$defs/StandardMeta" }
      }
    },
    "RouteEvaluateResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["routes", "unusable_route_ids", "capability", "policy_version", "limitations"],
          "properties": {
            "routes": { "type": "array", "items": { "$ref": "#/$defs/RouteCandidate" } },
            "unusable_route_ids": { "type": "array", "items": { "$ref": "#/$defs/Uuid" }, "uniqueItems": true },
            "capability": { "$ref": "#/$defs/CapabilityState" },
            "policy_version": { "type": "string", "minLength": 1, "maxLength": 100 },
            "limitations": { "type": "array", "items": { "$ref": "#/$defs/LimitationCode" }, "uniqueItems": true }
          }
        },
        "meta": { "$ref": "#/$defs/StandardMeta" }
      }
    },
    "EvidencePackageResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["snapshot_id", "assessments", "evidence", "routes", "capabilities", "limitations", "versions"],
          "properties": {
            "snapshot_id": { "$ref": "#/$defs/Uuid" },
            "assessments": { "type": "array", "items": { "$ref": "#/$defs/RiskAssessment" } },
            "evidence": { "type": "array", "items": { "$ref": "#/$defs/RetrievedEvidence" } },
            "routes": { "type": "array", "items": { "$ref": "#/$defs/RouteCandidate" } },
            "capabilities": { "type": "array", "items": { "$ref": "#/$defs/CapabilityState" } },
            "limitations": { "type": "array", "items": { "$ref": "#/$defs/LimitationCode" }, "uniqueItems": true },
            "versions": {
              "type": "object",
              "additionalProperties": false,
              "required": ["contract", "feature_schema", "model", "thresholds", "route_policy", "knowledge_collection"],
              "properties": {
