{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecisionResult",
  "description": "The locked decision. The policy chooses action_code from the evidence before any language model is called; the model may only write prose. A result whose validation.locked_action is false has been tampered with downstream and must be rejected rather than displayed.",
  "type": "object",
  "required": [
    "decision_id",
    "request_id",
    "snapshot_id",
    "action_code",
    "risk_level",
    "confidence",
    "rules_fired",
    "escalation_required",
    "summary",
    "reasons",
    "citations",
    "limitations",
    "versions",
    "validation",
    "created_at"
  ],
  "properties": {
    "decision_id": {
      "$ref": "primitives.schema.json#/$defs/Uuid"
    },
    "request_id": {
      "$ref": "primitives.schema.json#/$defs/Uuid"
    },
    "snapshot_id": {
      "$ref": "primitives.schema.json#/$defs/Uuid"
    },
    "action_code": {
      "$ref": "enums.schema.json#/$defs/ActionCode"
    },
    "risk_level": {
      "$ref": "enums.schema.json#/$defs/RiskLevel"
    },
    "confidence": {
      "$ref": "primitives.schema.json#/$defs/UnitInterval"
    },
    "selected_route_id": {
      "oneOf": [
        {
          "$ref": "primitives.schema.json#/$defs/Uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "rules_fired": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "escalation_required": {
      "type": "boolean"
    },
    "summary": {
      "description": "One or two sentences, safe to render after sanitisation.",
      "type": "string",
      "maxLength": 1000
    },
    "reasons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DecisionReason"
      }
    },
    "immediate_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ImmediateAction"
      },
      "default": []
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Citation"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Limitation"
      }
    },
    "versions": {
      "$ref": "#/$defs/DecisionVersions"
    },
    "validation": {
      "$ref": "#/$defs/DecisionValidation"
    },
    "created_at": {
      "$ref": "primitives.schema.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "DecisionReason": {
      "title": "DecisionReason",
      "type": "object",
      "required": [
        "code",
        "text"
      ],
      "properties": {
        "code": {
          "$ref": "risk-assessment.schema.json#/$defs/RiskReasonCode"
        },
        "text": {
          "type": "string",
          "maxLength": 1000
        },
        "severity": {
          "$ref": "enums.schema.json#/$defs/Severity"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "primitives.schema.json#/$defs/RecordId"
          },
          "default": []
        }
      }
    },
    "ImmediateAction": {
      "title": "ImmediateAction",
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 512
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 5
        },
        "evidence_id": {
          "oneOf": [
            {
              "$ref": "primitives.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Citation": {
      "title": "Citation",
      "description": "Every factual claim in the summary must be covered by one of these. Citations are produced from retrieved evidence and provenance records, never written by the language model.",
      "type": "object",
      "required": [
        "source_id",
        "title",
        "source_url"
      ],
      "properties": {
        "source_id": {
          "$ref": "primitives.schema.json#/$defs/RecordId"
        },
        "title": {
          "type": "string",
          "maxLength": 512
        },
        "source_url": {
          "$ref": "primitives.schema.json#/$defs/HttpsUrl"
        },
        "authority": {
          "$ref": "enums.schema.json#/$defs/SourceAuthority"
        },
        "observed_at": {
          "$ref": "primitives.schema.json#/$defs/NullableTimestamp"
        },
        "evidence_id": {
          "oneOf": [
            {
              "$ref": "primitives.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Limitation": {
      "title": "Limitation",
      "type": "object",
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "NO_RELIABLE_KNOWLEDGE_EVIDENCE",
            "PARTIAL_PROVIDER_COVERAGE",
            "STALE_EVIDENCE_USED",
            "NO_ROUTE_ALTERNATIVE_AVAILABLE",
            "MODE_NOT_SUPPORTED_IN_REGION",
            "FORECAST_HORIZON_EXCEEDED",
            "MODEL_UNAVAILABLE_CONSERVATIVE_RESULT",
            "EXPLANATION_FALLBACK_TEMPLATE",
            "CONFLICTING_SOURCES"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      }
    },
    "DecisionVersions": {
      "title": "DecisionVersions",
      "type": "object",
      "required": [
        "policy",
        "contract"
      ],
      "properties": {
        "policy": {
          "$ref": "primitives.schema.json#/$defs/SemVer"
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "llm_model": {
          "description": "Provider model id actually used, or null when the deterministic template produced the prose.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "contract": {
          "$ref": "primitives.schema.json#/$defs/SemVer"
        }
      }
    },
    "DecisionValidation": {
      "title": "DecisionValidation",
      "type": "object",
      "required": [
        "schema",
        "citations",
        "locked_action"
      ],
      "properties": {
        "schema": {
          "type": "boolean"
        },
        "citations": {
          "type": "boolean"
        },
        "locked_action": {
          "description": "True when the action the policy locked is byte-identical to the action being returned.",
          "type": "boolean"
        }
      }
    }
  }
}
