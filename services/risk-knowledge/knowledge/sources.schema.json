{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-travel.example/risk-knowledge/sources/1.0.0",
  "title": "Approved knowledge source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "collection_version", "sources"],
  "properties": {
    "manifest_version": { "const": "1.0.0" },
    "collection_version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "title",
          "authority",
          "source_url",
          "regions",
          "hazards",
          "languages",
          "effective_at",
          "expires_at",
          "review_due_at",
          "license",
          "checksum",
          "ingestion_method",
          "reviewer",
          "review_status"
        ],
        "properties": {
          "document_id": { "type": "string", "minLength": 1, "maxLength": 300 },
          "title": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "authority": { "enum": ["OFFICIAL", "INTERGOVERNMENTAL", "LICENSED_PROVIDER"] },
          "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "regions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
          "hazards": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "languages": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" } },
          "effective_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" },
          "review_due_at": { "type": "string", "format": "date-time" },
          "license": { "type": "string", "minLength": 1 },
          "checksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "ingestion_method": { "enum": ["ALLOWLIST_HTTPS_DOWNLOAD", "REVIEWED_LOCAL_IMPORT"] },
          "reviewer": { "type": "string", "minLength": 1 },
          "review_status": { "const": "APPROVED" }
        }
      }
    }
  }
}
