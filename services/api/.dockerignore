# Keep the build context small and keep secrets, tests and local state out of the image.

.git
.gitignore
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Never in an image: they are either secret or machine-specific.
.env
.env.*
*.pem
*.key

# Tests and local tooling are not part of the runtime.
tests
README.md
Makefile

# Editor and OS noise
.vscode
.idea
.DS_Store
Thumbs.db
