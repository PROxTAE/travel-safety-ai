# Keep the build context small and keep secrets, tests and local state out of the image.

.git
.gitignore
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Never in an image: they are either secret or machine-specific.
.env
.env.*
*.pem
*.key

# Tests ARE in the build context: the `dev` stage copies them so the suite can run inside the
# container against the same platform the service runs on. They never reach the `runtime` stage,
# which copies only .venv, app, migrations and alembic.ini — and CI asserts /app/tests is absent
# from the published image.
README.md
Makefile

# Editor and OS noise
.vscode
.idea
.DS_Store
Thumbs.db
