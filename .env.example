# คัดลอกเป็น .env แล้วเติมค่า — ไฟล์นี้มีแค่ "ชื่อ" กับคำอธิบาย ห้ามใส่ค่าจริงที่ใช้งานได้
# (.env ถูก .gitignore กันไว้ ห้าม commit)   ดู IMPLEMENTATION_PLANS/00_GIT_DOCKER_DELIVERY_RULES.md §9

# ---------- Runtime ----------
APP_ENV=development
LOG_LEVEL=INFO
CONTRACT_VERSION=1.0.0

# ---------- Database / cache (profile: core) ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=smart_travel
POSTGRES_USER=smart_travel          # required
POSTGRES_PASSWORD=                  # required — ตั้งเองต่อเครื่อง
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# ---------- Auth (Keycloak, profile: core) ----------
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_ADMIN=admin                # required (local only)
KEYCLOAK_ADMIN_PASSWORD=            # required — ตั้งเองต่อเครื่อง
OIDC_ISSUER=http://keycloak:8080/realms/smart-travel
OIDC_CLIENT_ID=web
OIDC_CLIENT_SECRET=

# ---------- Real providers (module 04) ----------
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com
ORS_BASE_URL=https://api.openrouteservice.org
ORS_API_KEY=                        # optional — ไม่มี = route provider unavailable
AMADEUS_BASE_URL=https://api.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
GDACS_BASE_URL=https://www.gdacs.org/gdacsapi
EONET_BASE_URL=https://eonet.gsfc.nasa.gov/api/v3
GTFS_PROVIDER_CONFIG=/app/config/providers.yaml

# ---------- LLM (module 07) ----------
OPENAI_API_KEY=                     # optional — ไม่มี = explanation ใช้ fixed template
OPENAI_EXPLAINER_MODEL=

# ---------- Internal service URLs (container DNS) ----------
AGENT_SERVICE_URL=http://agent:8001
EXTERNAL_DATA_SERVICE_URL=http://external-data:8002
DATA_INTEGRATION_SERVICE_URL=http://data-integration:8003
RISK_KNOWLEDGE_SERVICE_URL=http://risk-knowledge:8004
DECISION_SERVICE_URL=http://decision-engine:8005
RECOMMENDATION_SERVICE_URL=http://recommendation:8006
