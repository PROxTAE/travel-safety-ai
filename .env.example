# คัดลอกเป็น .env แล้วเติมค่า — ไฟล์นี้มีแค่ "ชื่อ" กับคำอธิบาย ห้ามใส่ค่าจริงที่ใช้งานได้
# (.env ถูก .gitignore กันไว้ ห้าม commit)   ดู IMPLEMENTATION_PLANS/00_GIT_DOCKER_DELIVERY_RULES.md §9

# ---------- Runtime ----------
APP_ENV=development
LOG_LEVEL=INFO
CONTRACT_VERSION=1.0.0

# ---------- Internal service auth (all internal APIs) ----------
INTERNAL_SERVICE_TOKEN=            # required — shared secret between internal services

# ---------- Database / cache (profile: core) ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=smart_travel
POSTGRES_USER=smart_travel          # required
POSTGRES_PASSWORD=                  # required — ตั้งเองต่อเครื่อง
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# ---------- Auth (Keycloak, profile: core) ----------
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_ADMIN=admin                # required (local only)
KEYCLOAK_ADMIN_PASSWORD=            # required — ตั้งเองต่อเครื่อง
OIDC_ISSUER=http://keycloak:8080/realms/smart-travel
OIDC_CLIENT_ID=web
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=smart-travel-api      # audience ที่ API ตรวจใน access token (module 02)

# ---------- Public API (module 02) ----------
# ทุกค่าด้านล่างมี default ในโค้ดแล้ว ใส่ตรงนี้เฉพาะเมื่อต้องการ override
API_CORS_ALLOWED_ORIGINS=http://localhost:3000   # ระบุ origin ตรง ๆ ห้ามใช้ * (response มี credential)
API_TRUSTED_PROXY_HOPS=0            # จำนวน reverse proxy ที่เชื่อถือได้; 0 = ไม่อ่าน X-Forwarded-For
API_MAX_REQUEST_BODY_BYTES=262144   # 256 KiB — public body ของระบบนี้เล็ก
API_READINESS_TIMEOUT_SECONDS=3     # งบรวมของ /health/ready
API_DB_POOL_SIZE=10
API_DB_MAX_OVERFLOW=5
API_DB_CONNECT_TIMEOUT_SECONDS=5
API_DB_STATEMENT_TIMEOUT_MS=10000   # ตัด query ที่ค้างฝั่ง server กัน pool หมด
API_REDIS_TIMEOUT_SECONDS=2
API_OIDC_TIMEOUT_SECONDS=3
API_DOWNSTREAM_CONNECT_TIMEOUT_SECONDS=2
API_DOWNSTREAM_READ_TIMEOUT_SECONDS=10

# emergency profile encryption (module 02) — ชื่อ key เท่านั้น ห้ามใส่ค่าจริง
# สร้างค่าใหม่: docker compose run --rm api python -m app.cli.generate_key
# รูปแบบ: v1:<base64>  หมุน key ด้วยการ "ต่อท้าย" ไม่ใช่แทนที่ เช่น v1:<เก่า>,v2:<ใหม่>
# ไม่ใส่ = endpoint emergency profile จะตอบ 503 (ไม่มีการเก็บแบบ plaintext เด็ดขาด)
API_EMERGENCY_ENCRYPTION_KEYS=
API_EMERGENCY_ENCRYPTION_ACTIVE_VERSION=       # ว่างไว้ = ใช้ key ตัวสุดท้ายในรายการ
API_CONSENT_LOCATION_ONCE_TTL_SECONDS=3600     # เพดานอายุ consent แชร์ตำแหน่งครั้งเดียว
API_CONSENT_LOCATION_LIVE_MAX_TTL_SECONDS=86400
API_CONSENT_RETENTION_DAYS=2555                # เก็บหลักฐาน consent ที่ถูกถอนแล้วนานกว่าตัว consent

# Trip domain (module 02, phase 4) — ค่าธุรกิจที่ปรับได้โดยไม่ต้องแก้โค้ด
API_TRIP_MAX_BACKDATE_SECONDS=3600             # ย้อนหลังได้แค่ไหน: คนที่ออกเดินทางแล้วยังบันทึกทริปได้
API_TRIP_MAX_FUTURE_DAYS=365                   # กันปีพิมพ์ผิดกลายเป็นทริปที่ประเมินไม่ได้
API_TRIP_SUPPORTED_TRAVEL_MODES=TRAIN,BUS,CAR,WALK,BICYCLE,MULTIMODAL
                                               # mode ที่ deployment นี้มี data source จริง
                                               # ไม่มี FLIGHT: ต้องใช้ Amadeus production ซึ่งยังไม่มี key
                                               # mode นอกรายการนี้ถูกปฏิเสธด้วย UNSUPPORTED_COVERAGE
API_TRIP_LIST_DEFAULT_LIMIT=20
API_LOCATION_SEARCH_CACHE_SECONDS=300          # อายุ cache ฝั่ง browser ของผลค้นหาสถานที่ (private เสมอ)

# ---------- Real providers (module 04) ----------
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com
ORS_BASE_URL=https://api.openrouteservice.org
ORS_API_KEY=                        # optional — ไม่มี = route provider unavailable
AMADEUS_BASE_URL=https://api.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
GDACS_BASE_URL=https://www.gdacs.org/gdacsapi
EONET_BASE_URL=https://eonet.gsfc.nasa.gov/api/v3
GTFS_PROVIDER_CONFIG=/app/config/providers.yaml

# ---------- LLM (module 07) ----------
OPENAI_API_KEY=                     # optional — ไม่มี = explanation ใช้ fixed template
OPENAI_EXPLAINER_MODEL=

# ---------- Internal service URLs (container DNS) ----------
AGENT_SERVICE_URL=http://agent:8001
EXTERNAL_DATA_SERVICE_URL=http://external-data:8002
DATA_INTEGRATION_SERVICE_URL=http://data-integration:8003
RISK_KNOWLEDGE_SERVICE_URL=http://risk-knowledge:8004
DECISION_SERVICE_URL=http://decision-engine:8005
RECOMMENDATION_SERVICE_URL=http://recommendation:8006

# ---------- Observability (shared) ----------
# ว่างไว้ = เก็บ trace ในโปรเซสแล้วทิ้ง ไม่ต้องมี collector ตอน dev
OTEL_EXPORTER_OTLP_ENDPOINT=
