# Public URL of the public API. Never point browsers at an internal service.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Map tiles are configured later when the MapLibre feature lands. Do not put provider secrets here.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_TOKEN=
# Visible provider attribution required by the selected tile provider's terms.
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# Server-only settings. Generate AUTH_SECRET locally; never commit it.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_KEYCLOAK_ID=web
# Public PKCE client needs no secret. Set only for a confidential deployment.
AUTH_KEYCLOAK_SECRET=
# Must be reachable by both the browser and the Next.js server, and match token issuer.
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/smart-travel
# Docker-only transport override; preserves the public issuer/Host.
AUTH_KEYCLOAK_INTERNAL_ORIGIN=http://keycloak:8080
# Inside Docker use the public API service DNS.
API_BASE_URL=http://api:8000

# LLM / Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
